<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ seo_title or title }} | Ozan Ferhat Şen</title>
  <meta name="description" content="{{ description or summary }}">
  <link rel="canonical" href="https://ozanferhatsen.com.tr{{ page.url }}">

  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ seo_title or title }}">
  <meta property="og:description" content="{{ description or summary }}">

  {% if image %}
  <meta property="og:image" content="https://ozanferhatsen.com.tr{{ image }}">
  {% endif %}

  <style>
    body {
      margin: 0;
      font-family: Georgia, serif;
      color: #1d1d1d;
      background: #fff;
      line-height: 1.75;
    }

    main {
      max-width: 820px;
      margin: 0 auto;
      padding: 60px 24px 100px;
    }

    .kategori {
      font-family: Arial, sans-serif;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #666;
    }

    h1 {
      font-size: clamp(34px, 5vw, 58px);
      line-height: 1.08;
      margin: 14px 0 22px;
    }

    .ozet {
      font-size: 21px;
      color: #555;
      margin-bottom: 32px;
    }

    .tarih {
      font-family: Arial, sans-serif;
      font-size: 14px;
      color: #777;
      margin-bottom: 42px;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    article {
      font-size: 19px;
    }

    article h2 {
      margin-top: 48px;
      line-height: 1.25;
    }

    article h3 {
      margin-top: 34px;
    }

    a {
      color: inherit;
    }
  </style>
</head>

<body>
  <main>
    <div class="kategori">
      {{ category }}{% if keyword %} · {{ keyword }}{% endif %}
    </div>

    <h1>{{ title }}</h1>

    <div class="ozet">{{ summary }}</div>

    <div class="tarih">
      Yayın tarihi: {{ date | date: "%d.%m.%Y" }}
      {% if updated %}
      · Son güncelleme: {{ updated | date: "%d.%m.%Y" }}
      {% endif %}
    </div>

    {% if image %}
    <p><img src="{{ image }}" alt="{{ title }}"></p>
    {% endif %}

    <article>
      {{ content | safe }}
    </article>
  </main>
</body>
</html>

{% set area = practiceAreas[practiceKey] %}
<section class="practice-hero">
  <div class="wrap">
    <div class="breadcrumbs"><a href="/">Ana Sayfa</a> / {{ area.name }}</div>
    <div class="practice-label">
      <span class="eyebrow">Çalışma Alanı · {{ area.name }}</span>
    </div>
    <h1>{{ area.h1 }}</h1>
    <p class="page-lead">{{ area.intro }}</p>
  </div>
</section>

<nav class="practice-jump" aria-label="{{ area.name }} sayfa içi menüsü">
  <div class="wrap">
    <a href="#yazilar">Yazılar</a>
    <a href="#risk-haritasi">Risk Haritası</a>
    <a href="#kritik-sorunlar">Kritik Sorunlar</a>
    <a href="#ilgili-basliklar">İlgili Başlıklar</a>
    <a href="#sss">Sık Sorulanlar</a>
  </div>
</nav>

{% include "components/practice-articles.njk" %}

<section class="section practice-risk-map" id="risk-haritasi">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Risk Haritası</div>
        <h2>{{ area.riskMapTitle }}</h2>
      </div>
      <p>{{ area.riskMapIntro }}</p>
    </div>
    <div class="risk-grid">
      {% for risk in area.risks %}
      <article class="risk-card">
        <div class="risk-index">0{{ loop.index }}</div>
        <h3>{{ risk.title }}</h3>
        <p>{{ risk.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section practice-problems" id="kritik-sorunlar">
  <div class="wrap">
    <div class="eyebrow">Üç Kritik Problem Kümesi</div>
    <div class="problem-list">
      {% for problem in area.problems %}
      {% set problemIndex = loop.index %}
      <article class="problem-block">
        <div class="problem-number">0{{ loop.index }}</div>
        <div class="problem-body">
          <h2>{{ problem.title }}</h2>
          <p>{{ problem.text }}</p>
          <div class="problem-points">
            {% for point in problem.points %}
              {% if accordionExplanations[practiceKey] and accordionExplanations[practiceKey][point] %}
              <details class="problem-accordion" name="problem-{{ practiceKey }}-{{ problemIndex }}">
                <summary>
                  <span>{{ point }}</span>
                  <span class="accordion-mark" aria-hidden="true"></span>
                </summary>
                <div class="accordion-content">
                  <p>{{ accordionExplanations[practiceKey][point] }}</p>
                </div>
              </details>
              {% else %}
              <div class="problem-point-static">{{ point }}</div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<div id="ilgili-basliklar">
{% include "components/practice-topics.njk" %}
</div>
{% include "components/practice-faq.njk" %}
{% include "components/practice-cta.njk" %}

{% set posts = collections.makaleler | byCategory(area.category) %}
{% set relatedPosts = posts | limit(6) %}
{% if relatedPosts.length %}
<section class="section soft practice-articles" aria-labelledby="{{ practiceKey }}-ilgili-makaleler">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">İlgili Makaleler</div>
        <h2 id="{{ practiceKey }}-ilgili-makaleler">Bu çalışma alanını derinleştiren içerikler</h2>
      </div>
      <p>Somut alt sorunları belge, içtihat ve uygulama riski üzerinden ayrıntılı ele alan içerikler.</p>
    </div>
    <div class="article-grid{% if relatedPosts.length < 3 %} article-grid-sparse{% endif %}">
      {% for post in relatedPosts %}
      <a class="article-card" href="{{ post.url }}">
        <div class="tag">{{ post.data.keyword or area.name }}</div>
        {% if post.data.date %}<div class="card-date">{{ post.data.date | dateTR }}</div>{% endif %}
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.summary }}</p>
        <span class="arrow">Makaleyi oku →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

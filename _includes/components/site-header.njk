{% set isHomepage = page.url == '/' or page.url == '/en/' %}
<header class="site-header" data-site-header>
  <div class="wrap nav">
    {% if lang == 'en' %}
    <a class="site-brand{% if isHomepage %} site-brand--dynamic{% endif %}" href="/en/" aria-label="Atty. Ozan Ferhat Şen home"{% if isHomepage %} data-dynamic-brand data-brand-transfer aria-hidden="true" tabindex="-1"{% endif %}>ATTY. OZAN FERHAT ŞEN</a>
    <nav class="nav-links" id="menu" aria-label="Main navigation">
      <details class="nav-dropdown">
        <summary>Practice Areas</summary>
        <div class="mega-menu">
          <div class="mega-column">
            <div class="mega-label">Property &amp; Development</div>
            {% for key, area in practiceAreas %}
              {% if key != 'kira' and area.enName and area.alternateEn %}
              <a href="{{ area.alternateEn | replace(site.url, '') }}">{{ area.enName }}</a>
              {% endif %}
            {% endfor %}
          </div>
          <div class="mega-column">
            <div class="mega-label">International Clients</div>
            <a href="/en/#guides">Practical Guides</a>
            <a href="/en/about/">About Ozan Ferhat Şen</a>
            <a href="/">Türkçe</a>
          </div>
        </div>
      </details>
      <a href="/en/#guides">Guides</a>
      <a href="/en/about/">About</a>
      <a href="/">Türkçe <span>TR</span></a>
      <div class="mobile-nav-footer">
        <a class="mobile-nav-contact" href="https://wa.me/905543398209">Contact in English</a>
      </div>
    </nav>
    <a class="nav-cta" href="https://wa.me/905543398209">Contact in English</a>
    {% else %}
    <a class="site-brand{% if isHomepage %} site-brand--dynamic{% endif %}" href="/" aria-label="Av. Ozan Ferhat Şen ana sayfa"{% if isHomepage %} data-dynamic-brand data-brand-transfer aria-hidden="true" tabindex="-1"{% endif %}>AV. OZAN FERHAT ŞEN</a>
    <nav class="nav-links" id="menu" aria-label="Ana menü">
      <details class="nav-dropdown">
        <summary>Çalışma Alanları</summary>
        <div class="mega-menu">
          <div class="mega-column">
            <div class="mega-label">Gayrimenkul &amp; Yapı</div>
            {% for key, area in practiceAreas %}
              {% if key != 'kira' and area.navGroup == 'property' %}
              <a href="{{ area.url }}">{{ area.name }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </details>
      <details class="nav-dropdown">
        <summary>Yayınlar</summary>
        <div class="mega-menu mega-menu--single">
          <div class="mega-column">
            <div class="mega-label">Yayınlar &amp; İçtihat</div>
            <a href="/makaleler/">Makaleler</a>
            <a href="/sss/">Sık Sorulan Sorular</a>
            <a href="/ictihat/">İçtihatlar</a>
            <a href="/ictihat/karar-haritalari/">İçtihat Ontolojisi</a>
            <a href="/blog/">Blog</a>
          </div>
        </div>
      </details>
      <a href="/blog/">Blog</a>
      <a href="/hakkimda/">Hakkımda</a>
      <a class="nav-search" href="/arama/" aria-label="Site içinde ara" title="Site içinde ara (⌘K / Ctrl+K)" data-search-trigger>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.25 4.25"></path></svg>
      </a>
      <a class="international-link" href="/en/">International <span>EN</span></a>
      <div class="mobile-nav-footer">
        <a class="mobile-nav-contact" href="/iletisim/">İletişim</a>
        <a class="mobile-nav-language" href="/en/">International <span>EN</span></a>
      </div>
    </nav>
    <a class="nav-cta" href="/iletisim/">İletişim</a>
    {% endif %}
    <div class="mobile-header-controls">
      {% if lang != 'en' %}
      <a class="mobile-search" href="/arama/" aria-label="Site içinde ara">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.25 4.25"></path></svg>
      </a>
      {% endif %}
      <button class="menu-btn" aria-label="{% if lang == 'en' %}Open menu{% else %}Menüyü aç{% endif %}" aria-controls="menu" aria-expanded="false" data-menu data-open-label="{% if lang == 'en' %}Open menu{% else %}Menüyü aç{% endif %}" data-close-label="{% if lang == 'en' %}Close menu{% else %}Menüyü kapat{% endif %}">☰</button>
    </div>
  </div>
</header>

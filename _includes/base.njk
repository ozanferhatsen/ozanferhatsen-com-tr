{% set currentPractice = false %}
{% if practiceKey and practiceAreas[practiceKey] %}
  {% set currentPractice = practiceAreas[practiceKey] %}
{% endif %}
{% set resolvedTitle = seo_title or title or site.name %}
{% set resolvedDescription = description or site.description %}
{% set resolvedAlternateTr = alternate_tr %}
{% set resolvedAlternateEn = alternate_en %}
{% if currentPractice %}
  {% set resolvedTitle = currentPractice.seoTitle %}
  {% set resolvedDescription = currentPractice.description %}
  {% set resolvedAlternateTr = currentPractice.alternateTr %}
  {% set resolvedAlternateEn = currentPractice.alternateEn %}
{% endif %}
<!doctype html>
<html lang="{{ lang or 'tr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ resolvedTitle }}</title>
  <meta name="description" content="{{ resolvedDescription }}">
  <meta name="robots" content="{{ robots or 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' }}">
  <link rel="canonical" href="{{ canonical or (site.url + page.url) }}">
  {% if resolvedAlternateTr %}<link rel="alternate" hreflang="tr" href="{{ resolvedAlternateTr }}">{% endif %}
  {% if resolvedAlternateEn %}<link rel="alternate" hreflang="en" href="{{ resolvedAlternateEn }}">{% endif %}
  {% if resolvedAlternateTr or resolvedAlternateEn %}<link rel="alternate" hreflang="x-default" href="{{ resolvedAlternateEn or resolvedAlternateTr }}">{% endif %}
  {% if lang == 'en' %}<meta property="og:locale" content="en_US">{% else %}<meta property="og:locale" content="tr_TR">{% endif %}
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }} | {{ site.brand }}">
  <meta property="og:title" content="{{ resolvedTitle }}">
  <meta property="og:description" content="{{ resolvedDescription }}">
  <meta property="og:url" content="{{ canonical or (site.url + page.url) }}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ resolvedTitle }}">
  <meta name="twitter:description" content="{{ resolvedDescription }}">
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="stylesheet" href="/assets/hero-fix.css">
  {% if currentPractice %}<link rel="stylesheet" href="/assets/practice-areas.css">{% endif %}
  {% if page_css %}<link rel="stylesheet" href="{{ page_css }}">{% endif %}
  {% if schema %}<script type="application/ld+json">{{ schema | safe }}</script>{% endif %}
  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://ozanferhatsen.com.tr/#ozan-ferhat-sen","name":"Ozan Ferhat Şen","url":"https://ozanferhatsen.com.tr/hakkimda/","jobTitle":"Avukat","alumniOf":[{"@type":"CollegeOrUniversity","name":"Dicle Üniversitesi Hukuk Fakültesi"},{"@type":"CollegeOrUniversity","name":"İstanbul Üniversitesi Sosyal Bilimler Enstitüsü"}]},{"@type":"LegalService","@id":"https://ozanferhatsen.com.tr/#hukuk-departmani","name":"Av. Ozan Ferhat Şen | Hukuk Departmanı","url":"https://ozanferhatsen.com.tr/","telephone":{{ site.phoneHref | json }},"email":{{ site.email | json }},"founder":{"@id":"https://ozanferhatsen.com.tr/#ozan-ferhat-sen"},"address":{"@type":"PostalAddress","streetAddress":{{ site.address | json }},"addressLocality":{{ site.district | json }},"addressRegion":{{ site.city | json }},"addressCountry":"TR"},"areaServed":"Türkiye","knowsAbout":[{% for key, area in practiceAreas %}{{ area.name | json }}{% if not loop.last %},{% endif %}{% endfor %}]},{"@type":"WebSite","@id":"https://ozanferhatsen.com.tr/#website","name":"Av. Ozan Ferhat Şen | Hukuk Departmanı","url":"https://ozanferhatsen.com.tr/","publisher":{"@id":"https://ozanferhatsen.com.tr/#hukuk-departmani"},"inLanguage":["tr-TR","en"]}]}</script>
</head>
<body>

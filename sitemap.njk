---
permalink: /sitemap.xml
excludeFromSitemap: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in collections.all %}
    {% if page.url and page.data.excludeFromSitemap != true and page.data.robots != "noindex,follow" %}
      {% set lastmodDate = (page.data.updated or page.data.date) | sitemapDate %}<url><loc>{{ site.url }}{{ page.url }}</loc>{% if lastmodDate %}<lastmod>{{ lastmodDate }}</lastmod>{% endif %}</url>
    {% endif %}
  {% endfor %}
</urlset>
